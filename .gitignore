@'
# Dependencies
node_modules/
**/node_modules/

# Environment variables / Secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Build files
dist/
**/dist/
build/
**/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing / Coverage
coverage/
.nyc_output/

# Cache
.cache/
.vite/
.turbo/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
'@ | Set-Content .gitignore